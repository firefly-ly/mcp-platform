# ===== 运行时数据（绝不入库）=====
*.log
*.db
*.db-shm
*.db-wal
uploads/
backups/
object-store/

# ===== 大体积二进制/制品 =====
# tools/* 而非 tools/：目录本身不入库但保留例外（docker-config 是 thv 弹窗修复的一部分）
tools/*
!tools/docker-config/
!tools/docker-config/config.json
*.tar
*.tar.gz
*.tgz
*.zip

# ===== 依赖 =====
node_modules/
__pycache__/
*.pyc
.venv/

# ===== 机密与环境 =====
.env
.env.*
!.env.example

# ===== 历史/临时 =====
*.bak
*~
_t_*.js
tmp-*.js

# ===== 系统 =====
Thumbs.db
.DS_Store

# ===== AI 工具数据 =====
.workbuddy/
_tmp_*
*.corrupt/
