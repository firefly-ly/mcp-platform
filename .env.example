# ===== 服务 =====
# 后端监听端口
PORT=4000
# 对外基础地址（生产填域名，如 https://mcp.example.com）
PUBLIC_BASE=

# ===== 网关信任门（生产必开）=====
# 1=启用：除 /health 外所有请求必须带 X-Gateway-Token（由前置网关注入）
TRUST_GATEWAY=
# 网关与后端共享的强随机令牌（openssl rand -hex 32）
GATEWAY_TOKEN=

# ===== 内部令牌 =====
# Next 服务端转发上传/内部调用所用令牌（强随机；不设则用弱默认值，仅限本地开发）
INTERNAL_PROXY_TOKEN=

# ===== 安全扫描 =====
# Trivy 可执行文件路径（不设则自动探测 tools/trivy/trivy.exe）
TRIVY_BIN=
# 漏洞库源（默认 AWS ECR Public；内网镜像源可覆盖）
TRIVY_DB_REPOSITORY=public.ecr.aws/aquasecurity/trivy-db:2

# ===== 上传限制 =====
# 上传体积上限（MB）
UPLOAD_MAX_MB=50

# ===== ToolHive =====
# thv 可执行文件路径（默认自动探测 %LOCALAPPDATA%\ToolHive\bin\thv.exe）
THV_BIN=
