{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "useUnknownInCatchVariables": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "services/**/*.js",
    "routes/**/*.js",
    "server.js"
  ],
  "exclude": ["node_modules", "test", "scripts", "eslint-report.json"]
}
